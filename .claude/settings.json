{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(gh api repos/synergievet/siteweb/*)",
      "PowerShell(git status *)",
      "PowerShell(git status)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push origin main)",
      "PowerShell(git stash *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(npm ci)",
      "PowerShell(npm.cmd ci)",
      "PowerShell(npm install)",
      "PowerShell(npm.cmd install)",
      "PowerShell(npm run *)",
      "PowerShell(npm.cmd run *)",
      "PowerShell(gh api repos/synergievet/siteweb/*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/demarrage.sh\"",
            "timeout": 180,
            "statusMessage": "Récupération de la dernière version du site…"
          }
        ]
      }
    ]
  }
}
